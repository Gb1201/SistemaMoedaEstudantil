@startuml
title Diagrama de Componentes - Sistema de Moeda Estudantil

skinparam linetype ortho

package "Lado do Cliente (Front-end)" {
  component "Aplicação Web (React)" as ReactApp
}

package "Lado do Servidor (Back-end - MVC)" {
  component "Controlador API (REST)" as API
  component "Autenticação / Segurança (JWT)" as Auth
  component "Camada de Serviço\n(Regras de Negócio)" as Service
  component "Camada de Repositório\n(JPA / Hibernate)" as Repo
}

package "Serviços Externos" {
  component "Provedor de E-mail" as Email
}

package "Camada de Dados" {
  database "PostgreSQL" as DB
}

'======================
' CONEXÕES bola-e-meia-lua
' A -0)- B  →  A fornece, B consome
'======================
ReactApp  -0)-  API     : API REST
API       -0)-  Auth    : Autenticação JWT
API       -0)-  Service : Serviço de Negócio
Service   -0)-  Repo    : Persistência de Dados
Service   -0)-  Email   : Serviço de E-mail

Repo --> DB : ORM / SQL

@enduml